generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

enum Size {
  PP
  P
  M
  G
  GG
}

model Sku {
  id          Int       @id @default(autoincrement())
  ean         String    @unique
  color       String
  size        Size      @default(M)
  description String?
  weight      Float
  length      Float
  height      Float
  width       Float
  active      Boolean   @default(true)
  products    Product[]

  @@index([id, ean])
  @@map("SKU")
}

model Store {
  id          Int     @id @default(autoincrement())
  description String
  corporeCode String
  location    String
  active      Boolean @default(true)
  stocks      Stock[]
  orders      Order[]

  @@index([id, corporeCode])
  @@map("FILIAL")
}

model Stock {
  id        Int     @id @default(autoincrement())
  ammount   Float
  product   Product @relation(fields: [productId], references: [id])
  store     Store   @relation(fields: [storeId], references: [id])
  active    Boolean @default(true)
  storeId   Int
  productId Int

  @@unique([storeId, productId])
  @@index([storeId, productId])
  @@map("ESTOQUE")
}

enum Type {
  VENDA
}

model StockMovement {
  id          Int       @id @default(autoincrement())
  productId   Int
  storeId     Int
  orderId     Int
  type        Type
  quantity    Float
  previousQty Float
  newQty      Float
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  @@unique([storeId, productId, orderId])
  @@index([productId, storeId, orderId])
  @@map("MOVIMENTACAO_ESTOQUE")
}

model Product {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  description String
  orderItems  OrderItem[]
  netValue    Decimal
  grossValue  Decimal
  active      Boolean     @default(true)
  stocks      Stock[]
  sku         Sku         @relation(fields: [skuId], references: [id])
  skuId       Int

  @@index([id, code, skuId])
  @@map("PRODUTO")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  email  String? @unique
  orders Order[]
  active Boolean @default(true)

  @@index([id, email])
  @@map("CLIENTE")
}

model OrderStatus {
  id          Int       @id @default(autoincrement())
  description String
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([id])
  @@map("STATUS_PEDIDO")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  ammount   Float
  value     Decimal
  order     Order?  @relation(fields: [orderId], references: [id])
  orderId   Int?

  @@index([id, productId, orderId])
  @@map("ITEM_PEDIDO")
}

model Order {
  id            Int         @id @default(autoincrement())
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerId    Int
  status        OrderStatus @relation(fields: [orderStatusId], references: [id])
  value         Decimal
  items         OrderItem[]
  store         Store       @relation(fields: [storeId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime?   @updatedAt
  orderStatusId Int
  storeId       Int

  @@index([id, customerId, orderStatusId])
  @@map("PEDIDO")
}
