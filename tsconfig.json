{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@api/*": ["./apps/api/*"],
      "@api/config/*": ["./apps/api/src/config/*"],
      "@api/common/*": ["./apps/api/src/common/*"],
      "@api/infra/*": ["./apps/api/src/infra/*"],
      "@queue/*": ["./apps/queuems/*"],
      "@queue/config/*": ["./apps/queuems/src/config/*"],
      "@queue/common/*": ["./apps/queuems/src/common/*"],
      "@queue/infra/*": ["./apps/queuems/src/infra/*"]
    }
  }
}
